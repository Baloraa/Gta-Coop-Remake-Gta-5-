<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GTACoop.Remake.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GTACoop Remake"
        Width="1180" Height="800"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="204" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sol gezinme -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="12,10,10,10">
                    <ToggleButton x:Name="SidebarToggle" Content="☰   Menüyü Daralt"
                                  HorizontalContentAlignment="Left" Padding="8,7" Margin="0,0,0,10"
                                  Background="Transparent" Foreground="{StaticResource TextBrush}"
                                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                  Cursor="Hand" Checked="OnSidebarToggle" Unchecked="OnSidebarToggle" />
                    <TextBlock x:Name="BrandSmallText" Text="GTA" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="BrandTitleText" Text="COOP REMAKE" FontSize="16" FontWeight="SemiBold"
                               Margin="0,1,0,2" />
                    <TextBlock x:Name="TaglineText" Text="GTA V çok oyunculu oyun yardımcısı"
                               Style="{StaticResource MutedText}" FontSize="11" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="14,6,14,12">
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,8" />
                    <TextBlock x:Name="LanguageLabel" Text="Dil"
                               Style="{StaticResource MutedText}" FontSize="10" Margin="2,0,0,4" />
                    <ComboBox x:Name="LangCombo" Margin="0,0,0,10"
                              ToolTip="Dil / Language / Язык"
                              SelectionChanged="OnLanguageChanged" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="UnofficialText" Text="Topluluk projesi"
                               Style="{StaticResource MutedText}" FontSize="10" Margin="0,3,0,0" />
                </StackPanel>

                <ListBox x:Name="Nav" SelectionChanged="OnNavChanged" Margin="10,0,10,0" />
            </DockPanel>
        </Border>

        <!-- İçerik -->
        <DockPanel Grid.Column="1" LastChildFill="True">
            <Border DockPanel.Dock="Bottom"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="18,9">
                <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Text="Hazır." />
            </Border>

            <StackPanel Margin="22,10,22,4">
                <TextBlock x:Name="PageTitle" Text="Genel Bakış" FontSize="19"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="PageSubtitle" Text="Oturumunu ve araçlarını tek yerden yönet."
                           Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>

            <ContentControl x:Name="Host" Margin="22,4,22,12" />
        </DockPanel>
    </Grid>
</Window>
