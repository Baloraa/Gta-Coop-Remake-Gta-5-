<Project Sdk="Microsoft.NET.Sdk">

  <!--
    GTACoop Remake - WinUI 3 launcher (yeni kabuk).
    Mevcut WinForms launcher (GTACoop.Launcher) özellik eşitliği sağlanana kadar
    yayınlanan sürümdür; bu proje kademeli geçişin ilk adımıdır.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>GTACoop.Remake.WinUI</RootNamespace>
    <AssemblyName>GTACoop.Launcher.WinUI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.*" />
    <!-- makepri.exe ve PRI MSBuild görevleri: Windows SDK kurulu olmayan
         makinelerde (yalnızca dotnet SDK) WinUI derlemesi bunlara ihtiyaç duyar. -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
  </ItemGroup>

</Project>
