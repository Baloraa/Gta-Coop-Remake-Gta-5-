<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="GTACoop.Remake.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- WinForms temasındaki renklerin WinUI 3 karşılıkları. -->
            <Color x:Key="GtBackground">#0D0D0F</Color>
            <Color x:Key="GtSurface">#121215</Color>
            <Color x:Key="GtSurfaceAlt">#1A1A1F</Color>
            <Color x:Key="GtBorder">#2A2A31</Color>
            <Color x:Key="GtText">#EDEDED</Color>
            <Color x:Key="GtMuted">#9AA0A6</Color>
            <Color x:Key="GtAccent">#35C759</Color>

            <SolidColorBrush x:Key="GtBackgroundBrush" Color="{StaticResource GtBackground}" />
            <SolidColorBrush x:Key="GtSurfaceBrush" Color="{StaticResource GtSurface}" />
            <SolidColorBrush x:Key="GtSurfaceAltBrush" Color="{StaticResource GtSurfaceAlt}" />
            <SolidColorBrush x:Key="GtBorderBrush" Color="{StaticResource GtBorder}" />
            <SolidColorBrush x:Key="GtTextBrush" Color="{StaticResource GtText}" />
            <SolidColorBrush x:Key="GtMutedBrush" Color="{StaticResource GtMuted}" />
            <SolidColorBrush x:Key="GtAccentBrush" Color="{StaticResource GtAccent}" />

            <x:Double x:Key="NavigationViewOpenPaneLength">248</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
